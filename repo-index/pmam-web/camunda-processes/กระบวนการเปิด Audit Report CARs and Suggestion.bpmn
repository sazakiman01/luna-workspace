    <bpmn:serviceTask id="Activity_1119cw9" name="แจ้งเตือนผู้ เกี่ยวข้อง" zeebe:modelerTemplate="Cloud_center_SendMail_Connecter" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="customConnector" />
        <zeebe:ioMapping>
          <zeebe:input source="GoflowEmail" target="authentication.type" />
          <zeebe:input source="html" target="sendMail_body_content_type" />
          <zeebe:input source="=&#34;รายงานผลการตรวจสอบข้อมูลประจำรอบ (ไม่พบ CARs และ Suggestions)&#34;" target="subject" />
          <zeebe:input source="=&#34;&#60;div style=&#39;font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 600px;&#39;&#62;&#34; +&#10;    &#34;&#60;p&#62;&#34; +&#10;        &#34;&#60;strong style=&#39;color: #1e88e5; font-size: 18px;&#39;&#62;แจ้งเตือนผลการตรวจสอบประจำรอบ&#60;/strong&#62;&#34; +&#10;    &#34;&#60;/p&#62;&#34; +&#10;    &#10;    &#34;&#60;p&#62;ระบบได้ทำการประมวลผลข้อมูล PMAM ประจำรอบที่กำหนดเรียบร้อยแล้ว โดยมีรายละเอียดดังนี้:&#60;/p&#62;&#34; +&#10;    &#10;    &#34;&#60;ul style=&#39;padding-left: 20px; margin: 15px 0;&#39;&#62;&#34; +&#10;        &#34;&#60;li style=&#39;margin-bottom: 8px;&#39;&#62;🔹 ไม่พบรายการ CARs และ Suggestions ในรอบนี้&#60;/li&#62;&#34; +&#10;        &#34;&#60;li style=&#39;margin-bottom: 8px;&#39;&#62;🔹 ข้อมูลที่ประมวลผลถูกต้องสมบูรณ์&#60;/li&#62;&#34; +&#10;        &#34;&#60;li style=&#39;margin-bottom: 8px;&#39;&#62;🔹 ไม่พบความผิดปกติของข้อมูลเพิ่มเติม&#60;/li&#62;&#34; +&#10;    &#34;&#60;/ul&#62;&#34; +&#10;&#10;    &#34;&#60;div style=&#39;background: #e3f2fd; padding: 15px; border-left: 5px solid #2196f3; margin-top: 15px;&#39;&#62;&#34; +&#10;        &#34;&#60;strong&#62;สรุปผล:&#60;/strong&#62;&#60;br&#62;&#34; +&#10;        &#34;ระบบทำงานสำเร็จและไม่พบรายการ CARs หรือ Suggestions ที่ต้องดำเนินการเพิ่มเติมค่ะ/ครับ&#34; +&#10;    &#34;&#60;/div&#62;&#34; +&#10;&#10;    &#34;&#60;p style=&#39;margin-top: 20px;&#39;&#62;หากต้องการตรวจสอบข้อมูลย้อนหลัง สามารถเข้าใช้งานระบบ PMAM ได้ตามสิทธิ์ของท่าน&#60;/p&#62;&#34; +&#10;    &#10;    &#34;&#60;p style=&#39;margin-top: 20px;&#39;&#62;&#60;strong&#62;ขอบคุณค่ะ/ครับ&#60;/strong&#62;&#60;br&#62;ระบบแจ้งเตือนอัตโนมัติ PMAM&#60;/p&#62;&#34; +&#10;    &#10;    &#34;&#60;p style=&#39;text-align: center; color: #888; font-size: 11px; margin-top: 30px; border-top: 1px solid #eee; padding-top: 10px;&#39;&#62;&#34; +&#10;        &#34;RPA Automation Service&#34; +&#10;    &#34;&#60;/p&#62;&#34; +&#10;&#34;&#60;/div&#62;&#34;" target="body" />
          <zeebe:input source="=[&#34;jumphonkae@gosoft.co.th&#34;]" target="sendto" />
          <zeebe:input source="=[&#34;jumphonkae@gosoft.co.th&#34;]" target="ccto" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="service" value="Cloud_SendMail" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1hryfbb</bpmn:incoming>
      <bpmn:outgoing>Flow_0g2lqlv</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_18cxgwn" name="อัพเดตฐานข้อมูล" zeebe:modelerTemplate="cloud-sql-connector" zeebe:modelerTemplateVersion="3" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="customConnector" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="POSTGRESQL" target="database" />
          <zeebe:input source="detailed" target="connection.authType" />
          <zeebe:input source="=&#34;{{secret.HOST_POSTGRESQL_PMAM}}&#34;" target="connection.host" />
          <zeebe:input source="=&#34;{{secret.PORT_POSTGRESQL_PMAM}}&#34;" target="connection.port" />
          <zeebe:input source="=&#34;{{secret.USERNAME_POSTGRESQL_PMAM}}&#34;" target="connection.username" />
          <zeebe:input source="=&#34;{{secret.PASSWORD_POSTGRESQL_PMAM}}&#34;" target="connection.password" />
          <zeebe:input source="=&#34;{{secret.DB_NAME_POSTGRESQL_PMAM}}&#34;" target="connection.databaseName" />
          <zeebe:input source="=true" target="data.returnResults" />
          <zeebe:input source="=&#34;UPDATE public.dc_audits SET audit_date = :audit_date, audit_time = :audit_time, area_id = :area_id, branch_id = :branch_id, approver = :approver, approver_title = :approver_title, approver_email = :approver_email, approver_employee_id = :approver_employee_id, car_major_count = :car_major_count, car_minor_count = :car_minor_count, suggestion_corrective_count = :suggestion_corrective_count, suggestion_preventive_count = :suggestion_preventive_count, status = :status, updated_at = NOW() WHERE doc_no = :doc_no&#34;" target="data.query" />
          <zeebe:input source="={doc_no: doc_no, audit_date: audit_date, audit_time: audit_time, area_id: area_id, branch_id: branch_id, approver: approver, approver_title: approver_title, approver_email: approver_email, approver_employee_id: approver_employee_id, car_major_count: car_major_count, car_minor_count: car_minor_count, suggestion_corrective_count: suggestion_corrective_count, suggestion_preventive_count: suggestion_preventive_count, status: status, audit_id: audit_id, cars: cars, suggestions: suggestions, created_by: created_by, created_at: created_at, audit_systems: audit_systems, representatives: representatives, auditors: auditors, objectives: objectives, activities: activities, items: items}&#10;" target="data.variables" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="service" value="sql" />
          <zeebe:header key="elementTemplateVersion" value="3" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.Jdbc.v1" />
          <zeebe:header key="resultVariable" value="output" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0oe8qs6</bpmn:incoming>
      <bpmn:outgoing>Flow_0wrlxk2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_0r34qte">
      <bpmn:incoming>Flow_00bwp54</bpmn:incoming>
      <bpmn:outgoing>Flow_07tc3sw</bpmn:outgoing>
      <bpmn:outgoing>Flow_1r11yru</bpmn:outgoing>
