    <bpmn:serviceTask id="Activity_0pyyi0f" name="Set Env" zeebe:modelerTemplate="cloud_set_global_env_connector" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/png;base64,">
