    <bpmn:serviceTask id="Activity_125zzpm" name="แจ้งเตือนผู้ เกี่ยวข้อง (Auditor)" zeebe:modelerTemplate="Cloud_center_SendMail_Connecter" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="customConnector" />
        <zeebe:ioMapping>
          <zeebe:input source="GoflowEmail" target="authentication.type" />
          <zeebe:input source="html" target="sendMail_body_content_type" />
          <zeebe:input source="=&#34;ผลการพิจารณา: ไม่อนุมัติการเปิด (CARs และ Suggestions)&#34;" target="subject" />
          <zeebe:input source="=&#34;&#60;div style=&#39;font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 650px;&#39;&#62;&#34; +&#10;&#10;    &#34;&#60;p&#62;&#60;strong style=&#39;color: #d32f2f; font-size: 20px;&#39;&#62;แจ้งผลการพิจารณา: ไม่อนุมัติการเปิด CARs / Suggestions&#60;/strong&#62;&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p&#62;ตามที่ท่านได้ดำเนินการส่งข้อมูลเพื่อขอเปิด CARs / Suggestions ระบบได้ส่งผลการตรวจสอบให้ผู้บริหารพิจารณาแล้ว และได้รับแจ้งว่า &#60;strong&#62;ไม่สามารถอนุมัติได้ในขณะนี้&#60;/strong&#62; เนื่องจากมีประเด็นที่ต้องตรวจสอบเพิ่มเติม&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;div style=&#39;background: #ffebee; padding: 15px; border-left: 5px solid #d32f2f; margin: 18px 0;&#39;&#62;&#34; +&#10;        &#34;&#60;strong&#62;สรุปผลการพิจารณา:&#60;/strong&#62;&#60;br&#62;&#34; +&#10;        &#34;คำขอเปิด CARs / Suggestions ยังไม่ผ่านการพิจารณา กรุณาทำการตรวจสอบข้อมูลที่เกี่ยวข้องและดำเนินการตามขั้นตอนที่ถูกต้องก่อนยื่นคำขอใหม่&#34; +&#10;    &#34;&#60;/div&#62;&#34; +&#10;&#10;    &#34;&#60;p&#62;หากต้องการส่งคำขออีกครั้ง กรุณาตรวจสอบความครบถ้วนของข้อมูลก่อนดำเนินการ เพื่อให้การพิจารณาเป็นไปอย่างราบรื่น&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p style=&#39;margin-top: 20px;&#39;&#62;&#60;strong&#62;ขอบคุณค่ะ/ครับ&#60;/strong&#62;&#60;br&#62;ระบบแจ้งเตือนอัตโนมัติ&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p style=&#39;text-align: center; color: #888; font-size: 11px; margin-top: 30px; border-top: 1px solid #eee; padding-top: 10px;&#39;&#62;&#34; +&#10;        &#34;RPA Automation Service&#34; +&#10;    &#34;&#60;/p&#62;&#34; +&#10;&#10;&#34;&#60;/div&#62;&#34;" target="body" />
          <zeebe:input source="=[&#34;jumphonkae@gosoft.co.th&#34;]" target="sendto" />
          <zeebe:input source="=[&#34;jumphonkae@gosoft.co.th&#34;]" target="ccto" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="service" value="Cloud_SendMail" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1f54oc2</bpmn:incoming>
      <bpmn:outgoing>Flow_1i4cfnw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_0h5h0qb" name="แจ้งเตือนผู้ เกี่ยวข้อง (Auditor)" zeebe:modelerTemplate="Cloud_center_SendMail_Connecter" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="customConnector" />
        <zeebe:ioMapping>
          <zeebe:input source="GoflowEmail" target="authentication.type" />
          <zeebe:input source="html" target="sendMail_body_content_type" />
          <zeebe:input source="=&#34;ผลการพิจารณา: อนุมัติการเปิด (CARs และ Suggestions)&#34;" target="subject" />
          <zeebe:input source="=&#34;&#60;div style=&#39;font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 650px;&#39;&#62;&#34; +&#10;&#10;    &#34;&#60;p&#62;&#60;strong style=&#39;color: #1e88e5; font-size: 20px;&#39;&#62;เปิด CARs / Suggestions เรียบร้อย&#60;/strong&#62;&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p&#62;ระบบได้ดำเนินการเปิดรายการตามข้อมูลที่ท่านส่งเข้ามาเรียบร้อยแล้ว โดยมีรายละเอียดดังนี้:&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;div style=&#39;margin: 15px 0;&#39;&#62;&#34; +&#10;        &#34;&#60;p&#62;&#60;strong&#62;📌 Corrective Action Requests (CARs)&#60;/strong&#62;&#60;/p&#62;&#34; +&#10;        &#34;&#60;ul style=&#39;padding-left: 20px;&#39;&#62;&#34; +&#10;            &#34;&#60;li&#62;จำนวน CARs ที่เปิด: &#60;strong&#62;&#34; + string(cars) + &#34;&#60;/strong&#62; รายการ&#60;/li&#62;&#34; +&#10;        &#34;&#60;/ul&#62;&#34; +&#10;    &#34;&#60;/div&#62;&#34; +&#10;&#10;    &#34;&#60;div style=&#39;margin: 15px 0;&#39;&#62;&#34; +&#10;        &#34;&#60;p&#62;&#60;strong&#62;💡 Suggestions&#60;/strong&#62;&#60;/p&#62;&#34; +&#10;        &#34;&#60;ul style=&#39;padding-left: 20px;&#39;&#62;&#34; +&#10;            &#34;&#60;li&#62;จำนวน Suggestions ที่เปิด: &#60;strong&#62;&#34; + string(suggestions) + &#34;&#60;/strong&#62; รายการ&#60;/li&#62;&#34; +&#10;        &#34;&#60;/ul&#62;&#34; +&#10;    &#34;&#60;/div&#62;&#34; +&#10;&#10;    &#34;&#60;div style=&#39;background: #e3f2fd; padding: 15px; border-left: 5px solid #2196f3; margin: 18px 0;&#39;&#62;&#34; +&#10;        &#34;&#60;strong&#62;สรุปผลการดำเนินการ:&#60;/strong&#62;&#60;br&#62;&#34; +&#10;        &#34;เปิดรายการ CARs และ Suggestions รวมทั้งสิ้น &#60;strong&#62;&#34; + string(cars + suggestions) + &#34;&#60;/strong&#62; รายการ และสามารถดำเนินงานต่อได้ตามขั้นตอนที่กำหนด&#34; +&#10;    &#34;&#60;/div&#62;&#34; +&#10;&#10;    &#34;&#60;p&#62;หากต้องการตรวจสอบข้อมูลเพิ่มเติม สามารถเข้าไปดูรายละเอียดได้ในระบบตามสิทธิ์การเข้าถึงของท่าน&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p style=&#39;margin-top: 20px;&#39;&#62;&#60;strong&#62;ขอบคุณค่ะ/ครับ&#60;/strong&#62;&#60;br&#62;ระบบแจ้งเตือนอัตโนมัติ&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p style=&#39;text-align: center; color: #888; font-size: 11px; margin-top: 30px; border-top: 1px solid #eee; padding-top: 10px;&#39;&#62;&#34; +&#10;        &#34;RPA Automation Service&#34; +&#10;    &#34;&#60;/p&#62;&#34; +&#10;&#10;&#34;&#60;/div&#62;&#34;&#10;" target="body" />
          <zeebe:input source="=[&#34;jumphonkae@gosoft.co.th&#34;]" target="sendto" />
          <zeebe:input source="=[&#34;jumphonkae@gosoft.co.th&#34;]" target="ccto" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="service" value="Cloud_SendMail" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0kc9n7q</bpmn:incoming>
      <bpmn:outgoing>Flow_154ella</bpmn:outgoing>
    </bpmn:serviceTask>
