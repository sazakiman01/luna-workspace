    <bpmn:serviceTask id="Activity_1ql9iot" name="แจ้งเตือน(Head Of Auditor)" zeebe:modelerTemplate="Cloud_center_SendMail_Connecter" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="customConnector" />
        <zeebe:ioMapping>
          <zeebe:input source="GoflowEmail" target="authentication.type" />
          <zeebe:input source="html" target="sendMail_body_content_type" />
          <zeebe:input source="=&#34;ผลการประมวลผลข้อมูลประจำรอบ: พบรายการ (CARs และ Suggestions) ที่ต้องดำเนินการ&#34;" target="subject" />
          <zeebe:input source="=&#34;&#60;div style=&#39;font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 650px;&#39;&#62;&#34; +&#10;&#10;    &#34;&#60;p&#62;&#60;strong style=&#39;color: #d32f2f; font-size: 20px;&#39;&#62;แจ้งเตือนผลการประมวลผลข้อมูล&#60;/strong&#62;&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p&#62;ระบบได้ทำการตรวจสอบข้อมูลแล้ว และพบว่ามีรายการที่ต้องดำเนินการ ดังนี้:&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;ul style=&#39;padding-left: 20px; margin: 15px 0;&#39;&#62;&#34; +&#10;        &#34;&#60;li&#62;🔸 Corrective Action Requests (CARs): &#60;strong&#62;&#34; + string(cars) + &#34;&#60;/strong&#62; รายการ&#60;/li&#62;&#34; +&#10;        &#34;&#60;li&#62;🔸 Suggestions: &#60;strong&#62;&#34; + string(suggestions) + &#34;&#60;/strong&#62; รายการ&#60;/li&#62;&#34; +&#10;        &#34;&#60;li&#62;🔸 รวมทั้งหมด: &#60;strong&#62;&#34; + string(cars + suggestions) + &#34;&#60;/strong&#62; รายการ&#60;/li&#62;&#34; +&#10;    &#34;&#60;/ul&#62;&#34; +&#10;&#10;    &#34;&#60;div style=&#39;background: #fff3e0; padding: 15px; border-left: 5px solid #f57c00; margin: 18px 0;&#39;&#62;&#34; +&#10;        &#34;&#60;strong&#62;สรุปผล:&#60;/strong&#62;&#60;br&#62;&#34; +&#10;        &#34;พบรายการ CARs และ/หรือ Suggestions ที่ต้องติดตาม กรุณาเข้าสู่ระบบเพื่อตรวจสอบรายละเอียดเพิ่มเติม&#34; +&#10;    &#34;&#60;/div&#62;&#34; +&#10;&#10;    &#34;&#60;p style=&#39;margin-top: 20px;&#39;&#62;&#60;strong&#62;ขอบคุณค่ะ/ครับ&#60;/strong&#62;&#60;br&#62;ระบบแจ้งเตือนอัตโนมัติ&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p style=&#39;text-align: center; color: #888; font-size: 11px; margin-top: 30px; border-top: 1px solid #eee; padding-top: 10px;&#39;&#62;RPA Automation Service&#60;/p&#62;&#34; +&#10;&#34;&#60;/div&#62;&#34;" target="body" />
          <zeebe:input source="=[&#34;jumphonkae@gosoft.co.th&#34;]" target="sendto" />
          <zeebe:input source="=[&#34;jumphonkae@gosoft.co.th&#34;]" target="ccto" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="service" value="Cloud_SendMail" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0lfl1uw</bpmn:incoming>
      <bpmn:outgoing>Flow_0lw4t1l</bpmn:outgoing>
    </bpmn:serviceTask>
