          <zeebe:input source="=&#34;&#60;div style=&#39;font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 650px;&#39;&#62;&#34; +&#10;&#10;    &#34;&#60;p&#62;&#60;strong style=&#39;color: #d32f2f; font-size: 20px;&#39;&#62;แจ้งผลการพิจารณา: ส่งกลับเพื่อแก้ไข&#60;/strong&#62;&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p&#62;ข้อมูลที่ส่งเข้าตรวจสอบยังไม่ผ่านการอนุมัติ และจำเป็นต้องปรับปรุงตามรายละเอียดดังต่อไปนี้:&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;div style=&#39;background: #ffebee; padding: 15px; border-left: 5px solid #d32f2f; margin: 18px 0;&#39;&#62;&#34; +&#10;        &#34;&#60;strong&#62;รายละเอียดที่ต้องแก้ไข:&#60;/strong&#62;&#60;br&#62;&#34; +&#10;        edit_detail +&#10;    &#34;&#60;/div&#62;&#34; +&#10;&#10;    &#34;&#60;p&#62;กรุณาตรวจสอบและแก้ไขข้อมูลให้ถูกต้องครบถ้วน ก่อนทำการส่งกลับเข้าสู่ระบบเพื่อพิจารณาใหม่อีกครั้ง&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p style=&#39;margin-top: 20px;&#39;&#62;&#60;strong&#62;ขอบคุณค่ะ/ครับ&#60;/strong&#62;&#60;br&#62;ระบบแจ้งเตือนอัตโนมัติ&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p style=&#39;text-align: center; color: #888; font-size: 11px; margin-top: 30px; border-top: 1px solid #eee; padding-top: 10px;&#39;&#62;&#34; +&#10;        &#34;RPA Automation Service&#34; +&#10;    &#34;&#60;/p&#62;&#34; +&#10;&#10;&#34;&#60;/div&#62;&#34;" target="body" />
          <zeebe:input source="=[&#34;jumphonkae@gosoft.co.th&#34;]" target="sendto" />
          <zeebe:input source="=[&#34;jumphonkae@gosoft.co.th&#34;]" target="ccto" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="service" value="Cloud_SendMail" />
        </zeebe:taskHeaders>
