    <bpmn:serviceTask id="Activity_1yvtpy5" name="อัพเดตฐานข้อมูล" zeebe:modelerTemplate="cloud-sql-connector" zeebe:modelerTemplateVersion="3" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
