    <bpmn:serviceTask id="Activity_1ifttcj" name="แจ้งผู้มีส่วนเกี่ยวข้อง" zeebe:modelerTemplate="Cloud_center_SendMail_Connecter" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="customConnector" />
        <zeebe:ioMapping>
          <zeebe:input source="GoflowEmail" target="authentication.type" />
          <zeebe:input source="html" target="sendMail_body_content_type" />
          <zeebe:input source="=&#34;กรอกแผนการแก้ไขและรายละเอียด OFI ภายใน 7 วัน&#34;" target="subject" />
          <zeebe:input source="=&#34;&#60;div style=&#39;font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 650px;&#39;&#62;&#34; +&#10;    &#34;&#60;p&#62;&#60;strong style=&#39;color: #ef6c00; font-size: 20px;&#39;&#62;แจ้งเตือนกรอกแผนการแก้ไขและรายละเอียด&#60;/strong&#62;&#60;/p&#62;&#34; +&#10;    &#34;&#60;p&#62;ระบบขอแจ้งให้ท่านทราบว่า มีรายการที่อยู่ระหว่างดำเนินการ ซึ่งจำเป็นต้องดำเนินการกรอกแผนการแก้ไขและรายละเอียด &#60;strong&#62;ภายใน 7 วัน&#60;/strong&#62; เพื่อให้เป็นไปตามขั้นตอนที่ระบบกำหนด&#60;/p&#62;&#34; +&#10;    &#34;&#60;div style=&#39;margin: 15px 0;&#39;&#62;&#34; +&#10;        &#34;&#60;p&#62;&#60;strong&#62;📌 รายละเอียดโดยสรุป&#60;/strong&#62;&#60;/p&#62;&#34; +&#10;        &#34;&#60;ul style=&#39;padding-left: 20px;&#39;&#62;&#34; +&#10;            &#34;&#60;li&#62;ประเภทรายการ: OFI&#60;/li&#62;&#34; +&#10;            &#34;&#60;li&#62;สถานะปัจจุบัน: &#60;strong&#62;รอกรอกแผนการแก้ไขและรายละเอียด&#60;/strong&#62;&#60;/li&#62;&#34; +&#10;            &#34;&#60;li&#62;ระยะเวลาที่กำหนด: &#60;strong style=&#39;color: #e53935;&#39;&#62;7 วัน นับจากวันที่ได้รับแจ้ง&#60;/strong&#62;&#60;/li&#62;&#34; +&#10;        &#34;&#60;/ul&#62;&#34; +&#10;    &#34;&#60;/div&#62;&#34; +&#10;    &#34;&#60;div style=&#39;background: #fff3e0; padding: 15px; border-left: 5px solid #fb8c00; margin: 18px 0;&#39;&#62;&#34; +&#10;        &#34;&#60;strong&#62;การดำเนินการที่ต้องทำ:&#60;/strong&#62;&#60;br&#62;&#34; +&#10;        &#34;กรุณาเข้าสู่ระบบเพื่อกรอกแผนการแก้ไขและรายละเอียด พร้อมทั้งระบุแนวทางและระยะเวลาการดำเนินการให้ครบถ้วน ตามรูปแบบที่กำหนด &#60;strong style=&#39;color: #e53935;&#39;&#62;ภายใน 7 วัน&#60;/strong&#62; หากไม่ดำเนินการภายในระยะเวลาที่กำหนด อาจส่งผลต่อขั้นตอนการดำเนินงานถัดไป&#34; +&#10;    &#34;&#60;/div&#62;&#34; +&#10;    &#34;&#60;p&#62;เมื่อดำเนินการเรียบร้อยแล้ว ระบบจะนำข้อมูลดังกล่าวเข้าสู่ขั้นตอนการพิจารณาและติดตามผลต่อไป&#60;/p&#62;&#34; +&#10;    &#34;&#60;p style=&#39;margin-top: 20px;&#39;&#62;&#60;strong&#62;ขอบคุณค่ะ/ครับ&#60;/strong&#62;&#60;br&#62;ระบบแจ้งเตือนอัตโนมัติ&#60;/p&#62;&#34; +&#10;    &#34;&#60;p style=&#39;text-align: center; color: #888; font-size: 11px; margin-top: 30px; border-top: 1px solid #eee; padding-top: 10px;&#39;&#62;&#34; +&#10;        &#34;RPA Automation Service&#34; +&#10;    &#34;&#60;/p&#62;&#34; +&#10;&#34;&#60;/div&#62;&#34;" target="body" />
          <zeebe:input source="=related_party_emails" target="sendto" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="service" value="Cloud_SendMail" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_05r1gic</bpmn:incoming>
      <bpmn:outgoing>Flow_0x2zsxx</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0x2zsxx" sourceRef="Activity_1ifttcj" targetRef="Event_1uk1txo" />
    <bpmn:endEvent id="Event_1uk1txo" name="จบการทำงาน">
      <bpmn:incoming>Flow_0x2zsxx</bpmn:incoming>
    </bpmn:endEvent>
