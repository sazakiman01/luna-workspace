    <bpmn:serviceTask id="Activity_07w61mo" name="แจ้งผู้มีส่วนเกี่ยวข้อง" zeebe:modelerTemplate="Cloud_center_SendMail_Connecter" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
