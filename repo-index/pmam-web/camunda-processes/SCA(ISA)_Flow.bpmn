    <bpmn:serviceTask id="Activity_1x6y2na" name="อัพเดตฐานข้อมูล" zeebe:modelerTemplate="cloud-sql-connector" zeebe:modelerTemplateVersion="3" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="customConnector" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="POSTGRESQL" target="database" />
          <zeebe:input source="detailed" target="connection.authType" />
          <zeebe:input source="=&#34;{{secret.HOST_POSTGRESQL_PMAM}}&#34;" target="connection.host" />
          <zeebe:input source="=&#34;{{secret.PORT_POSTGRESQL_PMAM}}&#34;" target="connection.port" />
          <zeebe:input source="=&#34;{{secret.USERNAME_POSTGRESQL_PMAM}}&#34;" target="connection.username" />
          <zeebe:input source="=&#34;{{secret.PASSWORD_POSTGRESQL_PMAM}}&#34;" target="connection.password" />
          <zeebe:input source="=&#34;{{secret.DB_NAME_POSTGRESQL_PMAM}}&#34;" target="connection.databaseName" />
          <zeebe:input source="=true" target="data.returnResults" />
          <zeebe:input source="=&#34;UPDATE public.isa_ofis SET status = &#39;followup_assigned&#39;, updated_at = NOW() AT TIME ZONE &#39;Asia/Bangkok&#39; WHERE doc_no = :doc_no AND process_instance_key = :strProcessInstanceKey;&#34;" target="data.query" />
          <zeebe:input source="={&#10;  doc_no: doc_no,&#10;  strProcessInstanceKey: strProcessInstanceKey&#10;}" target="data.variables" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="service" value="sql" />
          <zeebe:header key="elementTemplateVersion" value="3" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.Jdbc.v1" />
          <zeebe:header key="resultVariable" value="output" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0x934m1</bpmn:incoming>
      <bpmn:outgoing>Flow_1rif4d2</bpmn:outgoing>
    </bpmn:serviceTask>
