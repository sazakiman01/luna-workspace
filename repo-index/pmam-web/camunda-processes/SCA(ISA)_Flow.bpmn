    <bpmn:serviceTask id="Activity_0mczz3a" name="แจ้งผู้มีส่วนเกี่ยวข้อง" zeebe:modelerTemplate="Cloud_center_SendMail_Connecter" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="customConnector" />
        <zeebe:ioMapping>
          <zeebe:input source="GoflowEmail" target="authentication.type" />
          <zeebe:input source="html" target="sendMail_body_content_type" />
          <zeebe:input source="=&#34;Assign คนที่จะ Verify OFI&#34;" target="subject" />
          <zeebe:input source="=&#34;&#60;div style=&#39;font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 650px;&#39;&#62;&#34; +&#10;&#10;    &#34;&#60;p&#62;&#60;strong style=&#39;color: #2e7d32; font-size: 20px;&#39;&#62;แจ้งเตือนการมอบหมายผู้ตรวจสอบ OFI&#60;/strong&#62;&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p&#62;ระบบขอแจ้งให้ท่านทราบว่า ท่านได้รับการมอบหมายให้ทำหน้าที่เป็น &#60;strong&#62;ผู้ตรวจสอบ (Verifier)&#60;/strong&#62; สำหรับรายการ &#60;strong&#62;Opportunities for Improvement (OFI)&#60;/strong&#62; ที่อยู่ในกระบวนการติดตามและประเมินผลการแก้ไข&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;div style=&#39;margin: 15px 0;&#39;&#62;&#34; +&#10;        &#34;&#60;p&#62;&#60;strong&#62;📌 รายละเอียดโดยสรุป&#60;/strong&#62;&#60;/p&#62;&#34; +&#10;        &#34;&#60;ul style=&#39;padding-left: 20px;&#39;&#62;&#34; +&#10;            &#34;&#60;li&#62;ประเภทรายการ: Opportunities for Improvement (OFI)&#60;/li&#62;&#34; +&#10;            &#34;&#60;li&#62;บทบาทที่ได้รับมอบหมาย: &#60;strong&#62;ผู้ตรวจสอบ (Verifier)&#60;/strong&#62;&#60;/li&#62;&#34; +&#10;            &#34;&#60;li&#62;สถานะปัจจุบัน: &#60;strong&#62;รอการตรวจสอบผลการแก้ไข&#60;/strong&#62;&#60;/li&#62;&#34; +&#10;        &#34;&#60;/ul&#62;&#34; +&#10;    &#34;&#60;/div&#62;&#34; +&#10;&#10;    &#34;&#60;div style=&#39;background: #e8f5e9; padding: 15px; border-left: 5px solid #43a047; margin: 18px 0;&#39;&#62;&#34; +&#10;        &#34;&#60;strong&#62;การดำเนินการที่ต้องทำ:&#60;/strong&#62;&#60;br&#62;&#34; +&#10;        &#34;กรุณาเข้าสู่ระบบเพื่อตรวจสอบรายละเอียดการแก้ไข OFI พิจารณาความครบถ้วนและความเหมาะสมของแนวทางการปรับปรุง พร้อมให้ผลการประเมินตามขั้นตอนที่กำหนด&#34; +&#10;    &#34;&#60;/div&#62;&#34; +&#10;&#10;    &#34;&#60;p&#62;ผลการตรวจสอบของท่านจะถูกนำไปใช้ในกระบวนการพิจารณาอนุมัติหรือดำเนินการในขั้นตอนถัดไปของระบบ&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p style=&#39;margin-top: 20px;&#39;&#62;&#60;strong&#62;ขอบคุณค่ะ/ครับ&#60;/strong&#62;&#60;br&#62;ระบบแจ้งเตือนอัตโนมัติ&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p style=&#39;text-align: center; color: #888; font-size: 11px; margin-top: 30px; border-top: 1px solid #eee; padding-top: 10px;&#39;&#62;&#34; +&#10;        &#34;RPA Automation Service&#34; +&#10;    &#34;&#60;/p&#62;&#34; +&#10;&#10;&#34;&#60;/div&#62;&#34;" target="body" />
          <zeebe:input source="=related_party_emails" target="sendto" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="service" value="Cloud_SendMail" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1rif4d2</bpmn:incoming>
      <bpmn:outgoing>Flow_0bwtez7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Activity_1t4x2b7" name="Assign คนที่จะ Verify, OFI">
      <bpmn:extensionElements>
