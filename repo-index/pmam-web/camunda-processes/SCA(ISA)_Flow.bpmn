    <bpmn:serviceTask id="Activity_1jssbcj" name="แจ้งผู้มีส่วนเกี่ยวข้อง" zeebe:modelerTemplate="Cloud_center_SendMail_Connecter" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="customConnector" />
        <zeebe:ioMapping>
          <zeebe:input source="GoflowEmail" target="authentication.type" />
          <zeebe:input source="html" target="sendMail_body_content_type" />
          <zeebe:input source="=&#34;แจ้งเตือนกรอกรายละเอียดการแก้ไข OFI&#34;" target="subject" />
          <zeebe:input source="=&#34;&#60;div style=&#39;font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 650px;&#39;&#62;&#34; +&#10;&#10;    &#34;&#60;p&#62;&#60;strong style=&#39;color: #1976d2; font-size: 20px;&#39;&#62;แจ้งเตือนกรอกรายละเอียดการแก้ไข OFI&#60;/strong&#62;&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p&#62;ระบบขอแจ้งให้ท่านทราบว่า รายการ &#60;strong&#62;Opportunities for Improvement (OFI)&#60;/strong&#62; ที่ท่านมีส่วนเกี่ยวข้อง อยู่ในขั้นตอนที่จำเป็นต้องดำเนินการกรอกรายละเอียดการแก้ไข เพื่อใช้เป็นแนวทางในการปรับปรุงและพัฒนากระบวนการให้มีประสิทธิภาพยิ่งขึ้น&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;div style=&#39;margin: 15px 0;&#39;&#62;&#34; +&#10;        &#34;&#60;p&#62;&#60;strong&#62;📌 รายละเอียดโดยสรุป&#60;/strong&#62;&#60;/p&#62;&#34; +&#10;        &#34;&#60;ul style=&#39;padding-left: 20px;&#39;&#62;&#34; +&#10;            &#34;&#60;li&#62;ประเภทรายการ: Opportunities for Improvement (OFI)&#60;/li&#62;&#34; +&#10;            &#34;&#60;li&#62;สถานะปัจจุบัน: &#60;strong&#62;รอกรอกรายละเอียดการแก้ไข&#60;/strong&#62;&#60;/li&#62;&#34; +&#10;        &#34;&#60;/ul&#62;&#34; +&#10;    &#34;&#60;/div&#62;&#34; +&#10;&#10;    &#34;&#60;div style=&#39;background: #e3f2fd; padding: 15px; border-left: 5px solid #1e88e5; margin: 18px 0;&#39;&#62;&#34; +&#10;        &#34;&#60;strong&#62;การดำเนินการที่ต้องทำ:&#60;/strong&#62;&#60;br&#62;&#34; +&#10;        &#34;กรุณาเข้าสู่ระบบเพื่อกรอกรายละเอียดการแก้ไข OFI ให้ครบถ้วน โดยระบุแนวทางการปรับปรุง วิธีการดำเนินการ และข้อมูลที่เกี่ยวข้องตามรูปแบบที่ระบบกำหนด&#34; +&#10;    &#34;&#60;/div&#62;&#34; +&#10;&#10;    &#34;&#60;p&#62;ข้อมูลดังกล่าวจะถูกนำไปใช้ในกระบวนการติดตามผลและประเมินประสิทธิภาพของการปรับปรุงในลำดับถัดไป&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p style=&#39;margin-top: 20px;&#39;&#62;&#60;strong&#62;ขอบคุณค่ะ/ครับ&#60;/strong&#62;&#60;br&#62;ระบบแจ้งเตือนอัตโนมัติ&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p style=&#39;text-align: center; color: #888; font-size: 11px; margin-top: 30px; border-top: 1px solid #eee; padding-top: 10px;&#39;&#62;&#34; +&#10;        &#34;RPA Automation Service&#34; +&#10;    &#34;&#60;/p&#62;&#34; +&#10;&#10;&#34;&#60;/div&#62;&#34;&#10;" target="body" />
          <zeebe:input source="=related_party_emails" target="sendto" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="service" value="Cloud_SendMail" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_033xm6n</bpmn:incoming>
      <bpmn:outgoing>Flow_08kmn3p</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_03idy79" name="แจ้งเตือนผู้ เกี่ยวข้อง" zeebe:modelerTemplate="Cloud_center_SendMail_Connecter" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
