    <bpmn:serviceTask id="Activity_095kcl7" name="ส่ง Email หาหัวหน้าหน่วยงานที่ต้องแก้ไข CARs ใบนั้นๆ" zeebe:modelerTemplate="Cloud_center_SendMail_Connecter" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="customConnector" />
        <zeebe:ioMapping>
          <zeebe:input source="GoflowEmail" target="authentication.type" />
          <zeebe:input source="html" target="sendMail_body_content_type" />
          <zeebe:input source="=&#34;แจ้งเตือนมีการเปิด OFI&#34;" target="subject" />
          <zeebe:input source="=&#34;&#60;div style=&#39;font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 650px;&#39;&#62;&#34; +&#10;&#10;    &#34;&#60;p&#62;&#60;strong style=&#39;color: #1565c0; font-size: 20px;&#39;&#62;แจ้งเตือนการเปิด OFIs&#60;/strong&#62;&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p&#62;ระบบขอแจ้งให้ผู้มีส่วนเกี่ยวข้องทราบว่า ได้มีการเปิด Opportunities for Improvement (OFIs) ใหม่ในระบบ เพื่อใช้เป็นแนวทางในการปรับปรุงและพัฒนากระบวนการทำงานให้มีประสิทธิภาพยิ่งขึ้น&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;div style=&#39;margin: 15px 0;&#39;&#62;&#34; +&#10;        &#34;&#60;p&#62;&#60;strong&#62;📌 รายละเอียดโดยสรุป&#60;/strong&#62;&#60;/p&#62;&#34; +&#10;        &#34;&#60;ul style=&#39;padding-left: 20px;&#39;&#62;&#34; +&#10;            &#34;&#60;li&#62;ประเภทรายการ: Opportunities for Improvement (OFIs)&#60;/li&#62;&#34; +&#10;            &#34;&#60;li&#62;สถานะปัจจุบัน: &#60;strong&#62;เปิด OFI&#60;/strong&#62;&#60;/li&#62;&#34; +&#10;        &#34;&#60;/ul&#62;&#34; +&#10;    &#34;&#60;/div&#62;&#34; +&#10;&#10;    &#34;&#60;div style=&#39;background: #e3f2fd; padding: 15px; border-left: 5px solid #1e88e5; margin: 18px 0;&#39;&#62;&#34; +&#10;        &#34;&#60;strong&#62;การดำเนินการที่แนะนำ:&#60;/strong&#62;&#60;br&#62;&#34; +&#10;        &#34;กรุณาเข้าสู่ระบบเพื่อตรวจสอบรายละเอียดของ OFI และดำเนินการตามขั้นตอนที่เกี่ยวข้องภายในระยะเวลาที่กำหนด&#34; +&#10;    &#34;&#60;/div&#62;&#34; +&#10;&#10;    &#34;&#60;p&#62;ท่านสามารถตรวจสอบข้อมูลเพิ่มเติม และติดตามความคืบหน้าของรายการดังกล่าวได้ตามสิทธิ์การเข้าถึงของท่าน&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p style=&#39;margin-top: 20px;&#39;&#62;&#60;strong&#62;ขอบคุณค่ะ/ครับ&#60;/strong&#62;&#60;br&#62;ระบบแจ้งเตือนอัตโนมัติ&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p style=&#39;text-align: center; color: #888; font-size: 11px; margin-top: 30px; border-top: 1px solid #eee; padding-top: 10px;&#39;&#62;&#34; +&#10;        &#34;RPA Automation Service&#34; +&#10;    &#34;&#60;/p&#62;&#34; +&#10;&#34;&#60;/div&#62;&#34;" target="body" />
          <zeebe:input source="=related_party_emails" target="sendto" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="service" value="Cloud_SendMail" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1hw6u9t</bpmn:incoming>
      <bpmn:outgoing>Flow_1skmgy6</bpmn:outgoing>
    </bpmn:serviceTask>
