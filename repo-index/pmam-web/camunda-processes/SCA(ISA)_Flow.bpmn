    {
      "type": "separator",
      "layout": {
        "row": "Row_0omoj7l",
        "columns": null
      },
      "id": "Field_0fu8snp"
    },
    {
      "text": "#### Checklist สำหรับตรวจติดตามผลการแก้ไข OFI จากการตรวจ ISA",
      "type": "text",
      "layout": {
        "row": "Row_0vb6rea",
        "columns": null
      },
      "id": "Field_1y7mywo"
    },
    {
      "label": "1. Approach",
      "values": [
        {
          "label": "มี",
          "value": "มี"
        },
        {
          "label": "ไม่มี",
          "value": "ไม่มี"
        }
      ],
      "type": "radio",
      "layout": {
        "row": "Row_03s8mly",
        "columns": null
      },
      "id": "Field_1w338t7",
      "key": "ofi_approach_method_1",
      "description": "มีการกำหนดแนวทางและวิธีการในการแก้ไขปรับปรุง OFI ให้ครบถ้วนและสอดคล้องกับวัตถุประสงค์ตามประเด็นปัญหาของ OFI",
      "readonly": true
    },
    {
      "label": "2. Approach",
      "values": [
        {
          "label": "มี",
          "value": "มี"
        },
        {
          "label": "ไม่มี",
          "value": "ไม่มี"
        }
      ],
      "type": "radio",
      "layout": {
        "row": "Row_03s8mly",
        "columns": null
      },
      "id": "Field_14fcp8c",
      "key": "ofi_approach_responsibility_1",
      "description": "มีการกำหนดบทบาทหน้าที่ผู้รับผิดชอบในการดำเนินการแก้ไขปรับปรุง OFI ตามแนวทางหรือวิธีการได้ครบถ้วน",
      "readonly": "on"
    },
    {
      "label": "3. Deploy",
      "values": [
        {
          "label": "มี",
          "value": "มี"
        },
        {
          "label": "ไม่มี",
          "value": "ไม่มี"
        }
      ],
      "type": "radio",
      "layout": {
        "row": "Row_161fy9x",
        "columns": 8
      },
      "id": "Field_16vb77g",
      "key": "ofi_deploy_implementation_1",
      "description": "มีการดำเนินแก้ไขปรับปรุง OFI ตามแนวทางที่กำหนดได้ครบถ้วนโดยมีหลักฐานแสดงผลการดำเนินการในแต่ละแนวทางหรือวิธีการที่กำหนดไว้",
      "readonly": true
    },
    {
      "label": "4. Deploy",
      "values": [
        {
          "label": "มี",
          "value": "มี"
        },
        {
          "label": "ไม่มี",
          "value": "ไม่มี"
        }
      ],
      "type": "radio",
      "layout": {
        "row": "Row_161fy9x",
        "columns": null
      },
      "id": "Field_0wts7k4",
      "key": "ofi_deploy_communication_1",
      "description": "ผู้ที่มีส่วนเกี่ยวข้องกับการแก้ไข / ปรับปรุง OFI มีการสื่อสารให้เกิดความรู้และความเข้าใจในการดำเนินการได้ครบถ้วนและทำให้เกิดการปฏิบัติได้อย่างต่อเนื่อง",
      "readonly": "on"
    },
    {
      "label": "5. Learning",
      "values": [
        {
          "label": "มี",
          "value": "มี"
        },
        {
          "label": "ไม่มี",
          "value": "ไม่มี"
        }
      ],
      "type": "radio",
      "layout": {
        "row": "Row_1af8kxs",
        "columns": 8
      },
      "id": "Field_0tc4xjj",
      "key": "ofi_learning_checkpoint_1",
      "description": "มีการกำหนดจุดตรวจสอบ หรือ จุดควบคุม หรือ ตัวชี้วัด เพื่อติดตามประเมินประสิทธิผลการแก้ไขปรับปรุง OFI",
      "readonly": true
    },
    {
      "label": "6. Learning",
      "values": [
        {
          "label": "มี",
          "value": "มี"
        },
        {
          "label": "ไม่มี",
          "value": "ไม่มี"
        }
      ],
      "type": "radio",
      "layout": {
        "row": "Row_1af8kxs",
        "columns": null
      },
      "id": "Field_0o4om2u",
      "key": "ofi_learning_result_1",
      "description": "มีการสรุปข้อมูลเพื่อแสดงประสิทธิผลการแก้ไข/ปรับปรุง OFI จากจุดตรวจสอบ หรือ จุดควบคุม ที่กำหนด",
      "readonly": "on"
    },
    {
      "label": "7. Integrations",
      "values": [
        {
          "label": "มี",
          "value": "มี"
        },
        {
          "label": "ไม่มี",
          "value": "ไม่มี"
        }
      ],
      "type": "radio",
      "layout": {
        "row": "Row_0zik823",
        "columns": 8
      },
      "id": "Field_1ojgbes",
      "key": "ofi_integration_linkage_1",
      "description": "แนวทางการแก้ไขปรับปรุง OFI ได้มีการเชื่อมโยงไปยังกระบวนการ หรือ หน่วยงานที่เกี่ยวข้อง หรือ Next Process ที่สำคัญอย่างเป็นระบบ ",
      "readonly": true
    },
    {
      "label": "8. Integrations",
      "values": [
        {
          "label": "มี",
          "value": "มี"
        },
        {
          "label": "ไม่มี",
          "value": "ไม่มี"
        }
      ],
      "type": "radio",
      "layout": {
        "row": "Row_0zik823",
        "columns": null
      },
      "id": "Field_0u8vztm",
      "key": "ofi_integration_standard_1",
      "description": "มีการนำแนวทางไปจากการดำเนินการแก้ไข ป้องกัน OFI ไปทบทวนและจัดทำเป็นมาตรฐานการปฏิบัติงานอย่างชัดเจน",
      "readonly": "on"
    },
    {
      "label": "=\"ผลการ Follow Up OFI ครั้งที่ 1\"",
      "values": [
        {
          "label": "ผ่าน",
          "value": "ผ่าน"
        },
        {
          "label": "ไม่ผ่าน",
          "value": "ไม่ผ่าน"
        }
      ],
      "type": "select",
      "layout": {
        "row": "Row_1ukgidf",
        "columns": null
      },
      "id": "Field_0zzgo0l",
      "key": "eval_01",
      "validate": {
        "required": true
      },
      "readonly": true
    },
    {
      "label": "เหตุผลประกอบ",
      "type": "textarea",
      "layout": {
        "row": "Row_0t9b2eg",
        "columns": null
      },
      "id": "Field_15d9wsm",
      "key": "ofi_reason_1",
      "conditional": {
        "hide": "=eval_01 != \"ไม่ผ่าน\""
      },
      "readonly": "on"
    },
    {
      "text": "# หลักฐานการแก้ไข",
      "type": "text",
      "layout": {
        "row": "Row_0cpktc1",
        "columns": null
      },
      "id": "Field_1mycd3k"
    },
    {
      "label": "หลักฐานการตรวจ",
      "action": "submit",
      "type": "button",
      "layout": {
        "row": "Row_1w0il6k",
        "columns": null
      },
      "id": "Field_0swjss7",
      "properties": {
        "componentType": "downloadFiles",
        "locationFiles": "sharepoint",
        "namesite": "pmam",
        "foldersave": "SCA-ISA"
      }
    },
    {
      "text": "### รายละเอียดลงไปแก้ไขครั้งที่ 2",
      "type": "text",
      "layout": {
        "row": "Row_1cr9z3z",
        "columns": null
      },
      "id": "Field_0ogbx7d"
    },
    {
      "label": "รายละเอียด",
      "type": "textarea",
      "layout": {
        "row": "Row_1w57x6x",
        "columns": null
      },
      "id": "Field_0ttquj3",
      "key": "ofi_reason_2",
      "validate": {
        "required": true
      }
    }
  ],
  "type": "default",
  "id": "Form_1m15az6",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.6.0",
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.35.0"
  },
  "schemaVersion": 18
}</zeebe:userTaskForm>
