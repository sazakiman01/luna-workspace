          <zeebe:input source="=&#34;{{secret.DB_NAME_POSTGRESQL_PMAM}}&#34;" target="connection.databaseName" />
          <zeebe:input source="=true" target="data.returnResults" />
          <zeebe:input source="=&#34;UPDATE public.dc_items SET status = &#39;closed&#39;, updated_at = NOW() AT TIME ZONE &#39;Asia/Bangkok&#39; WHERE doc_no = :doc_no AND process_instance_key = :strProcessInstanceKey;&#34;" target="data.query" />
          <zeebe:input source="={&#10;  doc_no: doc_no,&#10;  strProcessInstanceKey: strProcessInstanceKey&#10;}" target="data.variables" />
