    <bpmn:serviceTask id="Activity_12gdiu0" name="แจ้งผู้มีส่วนเกี่ยวข้อง" zeebe:modelerTemplate="Cloud_center_SendMail_Connecter" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="customConnector" />
        <zeebe:ioMapping>
          <zeebe:input source="GoflowEmail" target="authentication.type" />
          <zeebe:input source="html" target="sendMail_body_content_type" />
          <zeebe:input source="=&#34;แจ้งเตือนประเมินครั้งที่ 2 งานตรวจคลังสินค้า DC&#34;" target="subject" />
          <zeebe:input source="=&#34;&#60;div style=&#39;font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 600px;&#39;&#62;&#34; +&#10;    &#34;&#60;p&#62;&#34; +&#10;        &#34;&#60;strong style=&#39;color: #1e88e5; font-size: 18px;&#39;&#62;แจ้งเตือนการประเมินผลครั้งที่ 2&#60;/strong&#62;&#34; +&#10;    &#34;&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p&#62;ภายหลังจากการเข้าตรวจคลังสินค้า DC และการดำเนินการแก้ไขเพิ่มเติมตามผลการประเมินครั้งที่ 1 &#34; +&#10;    &#34;ที่ได้บันทึกไว้ในระบบ&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p&#62;ขณะนี้ ระบบขอแจ้งเตือนให้ท่านดำเนินการ &#60;strong&#62;ประเมินผลการแก้ไข ครั้งที่ 2&#60;/strong&#62; &#34; +&#10;    &#34;เพื่อพิจารณาความครบถ้วน ความถูกต้อง และประสิทธิผลของการแก้ไขตามข้อเสนอแนะ &#34; +&#10;    &#34;และแนวทางที่ได้กำหนดไว้&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;ul style=&#39;padding-left: 20px; margin: 15px 0;&#39;&#62;&#34; +&#10;        &#34;&#60;li style=&#39;margin-bottom: 8px;&#39;&#62;🔹 ตรวจสอบการปรับปรุงและแก้ไขตามผลการประเมินครั้งที่ 1&#60;/li&#62;&#34; +&#10;        &#34;&#60;li style=&#39;margin-bottom: 8px;&#39;&#62;🔹 ประเมินความสอดคล้องกับข้อกำหนดและมาตรฐานที่เกี่ยวข้อง&#60;/li&#62;&#34; +&#10;        &#34;&#60;li style=&#39;margin-bottom: 8px;&#39;&#62;🔹 บันทึกผลการประเมินครั้งที่ 2 ผ่านระบบ&#60;/li&#62;&#34; +&#10;    &#34;&#60;/ul&#62;&#34; +&#10;&#10;    &#34;&#60;div style=&#39;background: #e3f2fd; padding: 15px; border-left: 5px solid #2196f3; margin-top: 15px;&#39;&#62;&#34; +&#10;        &#34;&#60;strong&#62;สถานะปัจจุบัน:&#60;/strong&#62;&#60;br&#62;&#34; +&#10;        &#34;อยู่ระหว่างขั้นตอนการประเมินผลการแก้ไขครั้งที่ 2 จากการเข้าตรวจคลังสินค้า DC&#34; +&#10;    &#34;&#60;/div&#62;&#34; +&#10;&#10;    &#34;&#60;p style=&#39;margin-top: 20px;&#39;&#62;กรุณาดำเนินการประเมินและบันทึกผลให้แล้วเสร็จภายในระยะเวลาที่กำหนด &#34; +&#10;    &#34;เพื่อให้สามารถพิจารณาผลสรุป และดำเนินการในขั้นตอนถัดไปได้อย่างครบถ้วนตามกระบวนการ&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p style=&#39;margin-top: 20px;&#39;&#62;&#60;strong&#62;ขอบคุณค่ะ/ครับ&#60;/strong&#62;&#60;br&#62;&#34; +&#10;    &#34;ระบบแจ้งเตือนอัตโนมัติ&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p style=&#39;text-align: center; color: #888; font-size: 11px; margin-top: 30px; border-top: 1px solid #eee; padding-top: 10px;&#39;&#62;&#34; +&#10;        &#34;Enterprise Automation | DC Evaluation Notification Service&#34; +&#10;    &#34;&#60;/p&#62;&#34; +&#10;&#34;&#60;/div&#62;&#34;" target="body" />
          <zeebe:input source="=[&#34;jumphonkae@gosoft.co.th&#34;]" target="sendto" />
          <zeebe:input source="=[&#34;jumphonkae@gosoft.co.th&#34;]" target="ccto" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="service" value="Cloud_SendMail" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0exav3i</bpmn:incoming>
      <bpmn:incoming>Flow_0yyh97u</bpmn:incoming>
      <bpmn:outgoing>Flow_0b68m8c</bpmn:outgoing>
    </bpmn:serviceTask>
