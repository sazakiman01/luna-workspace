    <bpmn:serviceTask id="Activity_1tzngkv" name="แจ้งผู้มีส่วนเกี่ยวข้อง" zeebe:modelerTemplate="Cloud_center_SendMail_Connecter" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="customConnector" />
        <zeebe:ioMapping>
          <zeebe:input source="GoflowEmail" target="authentication.type" />
          <zeebe:input source="html" target="sendMail_body_content_type" />
          <zeebe:input source="=&#34;แจ้งเตือนการประเมินครั้งที่ 1 งานตรวจคลังสินค้า DC&#34;" target="subject" />
          <zeebe:input source="=&#34;&#60;div style=&#39;font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 600px;&#39;&#62;&#34; +&#10;    &#34;&#60;p&#62;&#34; +&#10;        &#34;&#60;strong style=&#39;color: #1e88e5; font-size: 18px;&#39;&#62;แจ้งเตือนการประเมินผลครั้งที่ 1&#60;/strong&#62;&#34; +&#10;    &#34;&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p&#62;ภายหลังจากการเข้าตรวจคลังสินค้า DC และการดำเนินการแก้ไขตามแผนที่ได้บันทึกไว้ในระบบเรียบร้อยแล้ว&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p&#62;ระบบขอแจ้งเตือนให้ท่านดำเนินการ &#60;strong&#62;ประเมินผลการแก้ไขครั้งที่ 1&#60;/strong&#62; &#34; +&#10;    &#34;เพื่อพิจารณาความถูกต้อง ความครบถ้วน และความสอดคล้องของการแก้ไขตามแผนที่กำหนดไว้ &#34; +&#10;    &#34;รวมถึงบันทึกผลการประเมินผ่านระบบตามขั้นตอนที่กำหนด&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;ul style=&#39;padding-left: 20px; margin: 15px 0;&#39;&#62;&#34; +&#10;        &#34;&#60;li style=&#39;margin-bottom: 8px;&#39;&#62;🔹 ตรวจสอบการดำเนินการแก้ไขตามแผนที่กำหนด&#60;/li&#62;&#34; +&#10;        &#34;&#60;li style=&#39;margin-bottom: 8px;&#39;&#62;🔹 ประเมินความเหมาะสมและประสิทธิผลของการแก้ไข&#60;/li&#62;&#34; +&#10;        &#34;&#60;li style=&#39;margin-bottom: 8px;&#39;&#62;🔹 บันทึกผลการประเมินครั้งที่ 1 ในระบบ&#60;/li&#62;&#34; +&#10;    &#34;&#60;/ul&#62;&#34; +&#10;&#10;    &#34;&#60;div style=&#39;background: #e8f5e9; padding: 15px; border-left: 5px solid #43a047; margin-top: 15px;&#39;&#62;&#34; +&#10;        &#34;&#60;strong&#62;สถานะปัจจุบัน:&#60;/strong&#62;&#60;br&#62;&#34; +&#10;        &#34;อยู่ระหว่างขั้นตอนการประเมินผลการแก้ไขครั้งที่ 1 จากการเข้าตรวจคลังสินค้า DC&#34; +&#10;    &#34;&#60;/div&#62;&#34; +&#10;&#10;    &#34;&#60;p style=&#39;margin-top: 20px;&#39;&#62;กรุณาดำเนินการให้แล้วเสร็จภายในระยะเวลาที่กำหนด &#34; +&#10;    &#34;เพื่อให้สามารถดำเนินการในขั้นตอนถัดไปได้อย่างต่อเนื่อง หากพบประเด็นที่ต้องแก้ไขเพิ่มเติม &#34; +&#10;    &#34;สามารถบันทึกข้อเสนอแนะหรือผลการประเมินผ่านระบบได้โดยตรง&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p style=&#39;margin-top: 20px;&#39;&#62;&#60;strong&#62;ขอบคุณค่ะ/ครับ&#60;/strong&#62;&#60;br&#62;&#34; +&#10;    &#34;ระบบแจ้งเตือนอัตโนมัติ&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p style=&#39;text-align: center; color: #888; font-size: 11px; margin-top: 30px; border-top: 1px solid #eee; padding-top: 10px;&#39;&#62;&#34; +&#10;        &#34;Enterprise Automation | DC Evaluation Notification Service&#34; +&#10;    &#34;&#60;/p&#62;&#34; +&#10;&#34;&#60;/div&#62;&#34;" target="body" />
          <zeebe:input source="=[&#34;jumphonkae@gosoft.co.th&#34;]" target="sendto" />
          <zeebe:input source="=[&#34;jumphonkae@gosoft.co.th&#34;]" target="ccto" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="service" value="Cloud_SendMail" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0gz2r9s</bpmn:incoming>
      <bpmn:outgoing>Flow_1m05xka</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_1khichu" name="อัพเดตฐานข้อมูล" zeebe:modelerTemplate="cloud-sql-connector" zeebe:modelerTemplateVersion="3" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="customConnector" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="POSTGRESQL" target="database" />
          <zeebe:input source="detailed" target="connection.authType" />
          <zeebe:input source="=&#34;{{secret.HOST_POSTGRESQL_PMAM}}&#34;" target="connection.host" />
          <zeebe:input source="=&#34;{{secret.PORT_POSTGRESQL_PMAM}}&#34;" target="connection.port" />
          <zeebe:input source="=&#34;{{secret.USERNAME_POSTGRESQL_PMAM}}&#34;" target="connection.username" />
          <zeebe:input source="=&#34;{{secret.PASSWORD_POSTGRESQL_PMAM}}&#34;" target="connection.password" />
          <zeebe:input source="=&#34;{{secret.DB_NAME_POSTGRESQL_PMAM}}&#34;" target="connection.databaseName" />
