    <bpmn:serviceTask id="Activity_170nl0p" name="แจ้งเตือนผู้มีส่วนเกี่ยวข้อง (อนุมัติปิด Sugesstion)" zeebe:modelerTemplate="Cloud_center_SendMail_Connecter" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="customConnector" />
        <zeebe:ioMapping>
