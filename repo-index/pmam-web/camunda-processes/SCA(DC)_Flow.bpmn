    <bpmn:serviceTask id="Activity_1opvdgg" name="แจ้งผู้มีส่วนเกี่ยวข้อง" zeebe:modelerTemplate="Cloud_center_SendMail_Connecter" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="customConnector" />
        <zeebe:ioMapping>
          <zeebe:input source="GoflowEmail" target="authentication.type" />
          <zeebe:input source="html" target="sendMail_body_content_type" />
          <zeebe:input source="=&#34;แจ้งเตือนผลการประเมินครั้งที่ 1 ไม่ผ่าน (DC)&#34;" target="subject" />
          <zeebe:input source="=&#34;&#60;div style=&#39;font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 600px;&#39;&#62;&#34; +&#10;    &#34;&#60;p&#62;&#34; +&#10;        &#34;&#60;strong style=&#39;color: #e53935; font-size: 18px;&#39;&#62;แจ้งเตือนผลการประเมินครั้งที่ 1 ไม่ผ่าน&#60;/strong&#62;&#34; +&#10;    &#34;&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p&#62;จากการเข้าตรวจคลังสินค้า DC และการดำเนินการแก้ไขตามแผนที่ได้บันทึกไว้ในระบบ &#34; +&#10;    &#34;ได้มีการดำเนินการประเมินผลการแก้ไข &#60;strong&#62;ครั้งที่ 1&#60;/strong&#62; เรียบร้อยแล้ว&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p&#62;ผลการประเมินพบว่า &#60;strong&#62;การแก้ไขยังไม่ผ่านเกณฑ์การประเมิน&#60;/strong&#62; &#34; +&#10;    &#34;ตามข้อกำหนดและเงื่อนไขที่กำหนดไว้&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p&#62;ระบบจึงขอแจ้งเตือนให้ &#60;strong&#62;ผู้ดำเนินการแก้ไข&#60;/strong&#62; &#34; +&#10;    &#34;กรอกรายละเอียดการแก้ไขเพิ่มเติม และปรับปรุงการดำเนินการให้สอดคล้องกับผลการประเมิน &#34; +&#10;    &#34;พร้อมบันทึกข้อมูลผ่านระบบ เพื่อเข้าสู่กระบวนการพิจารณาในขั้นตอนถัดไป&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;div style=&#39;background: #ffebee; padding: 15px; border-left: 5px solid #e53935; margin-top: 15px;&#39;&#62;&#34; +&#10;        &#34;&#60;strong&#62;สถานะปัจจุบัน:&#60;/strong&#62;&#60;br&#62;&#34; +&#10;        &#34;ผลการประเมินครั้งที่ 1 ไม่ผ่าน และอยู่ระหว่างการดำเนินการแก้ไขเพิ่มเติม&#34; +&#10;    &#34;&#60;/div&#62;&#34; +&#10;&#10;    &#34;&#60;p style=&#39;margin-top: 20px;&#39;&#62;กรุณาดำเนินการกรอกรายละเอียดการแก้ไขให้ครบถ้วนภายในระยะเวลาที่กำหนด &#34; +&#10;    &#34;เพื่อให้สามารถดำเนินการประเมินซ้ำและติดตามผลได้อย่างต่อเนื่อง&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p style=&#39;margin-top: 20px;&#39;&#62;&#60;strong&#62;ขอบคุณค่ะ/ครับ&#60;/strong&#62;&#60;br&#62;&#34; +&#10;    &#34;ระบบแจ้งเตือนอัตโนมัติ&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p style=&#39;text-align: center; color: #888; font-size: 11px; margin-top: 30px; border-top: 1px solid #eee; padding-top: 10px;&#39;&#62;&#34; +&#10;        &#34;Enterprise Automation | DC Evaluation Notification Service&#34; +&#10;    &#34;&#60;/p&#62;&#34; +&#10;&#34;&#60;/div&#62;&#34;" target="body" />
          <zeebe:input source="=[&#34;jumphonkae@gosoft.co.th&#34;]" target="sendto" />
          <zeebe:input source="=[&#34;jumphonkae@gosoft.co.th&#34;]" target="ccto" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="service" value="Cloud_SendMail" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1f8octr</bpmn:incoming>
      <bpmn:outgoing>Flow_1kxxi4s</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_13ez8ex" name="อัพเดตฐานข้อมูล" zeebe:modelerTemplate="cloud-sql-connector" zeebe:modelerTemplateVersion="3" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
