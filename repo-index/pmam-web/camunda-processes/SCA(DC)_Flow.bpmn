    <bpmn:serviceTask id="Activity_00cdo43" name="แจ้งผู้มีส่วนเกี่ยวข้อง" zeebe:modelerTemplate="Cloud_center_SendMail_Connecter" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="customConnector" />
        <zeebe:ioMapping>
          <zeebe:input source="GoflowEmail" target="authentication.type" />
          <zeebe:input source="html" target="sendMail_body_content_type" />
          <zeebe:input source="=&#34;แจ้งยืนยันการกรอกแผนการแก้ไขจากการเข้าตรวจคลังสินค้า DC เรียบร้อยแล้ว&#34;" target="subject" />
          <zeebe:input source="=&#34;&#60;div style=&#39;font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 600px;&#39;&#62;&#34; +&#10;    &#34;&#60;p&#62;&#34; +&#10;        &#34;&#60;strong style=&#39;color: #1e88e5; font-size: 18px;&#39;&#62;แจ้งยืนยันการกรอกแผนการแก้ไข&#60;/strong&#62;&#34; +&#10;    &#34;&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p&#62;ตามที่หน่วยงานได้ดำเนินการเข้าตรวจคลังสินค้า DC ตามรอบที่กำหนด &#34; +&#10;    &#34;และได้มีการบันทึกประเด็นที่ต้องดำเนินการแก้ไขไว้ในระบบ&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p&#62;ขณะนี้ ท่านได้ดำเนินการ &#60;strong&#62;กรอกแผนการแก้ไขเรียบร้อยแล้ว&#60;/strong&#62; &#34; +&#10;    &#34;ระบบได้รับข้อมูลดังกล่าวเป็นที่เรียบร้อย และจะนำไปใช้ในขั้นตอนการพิจารณา ติดตามผล และดำเนินการในลำดับถัดไปตามกระบวนการที่กำหนด&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;div style=&#39;background: #e8f5e9; padding: 15px; border-left: 5px solid #43a047; margin-top: 15px;&#39;&#62;&#34; +&#10;        &#34;&#60;strong&#62;สถานะปัจจุบัน:&#60;/strong&#62;&#60;br&#62;&#34; +&#10;        &#34;ข้อมูลแผนการแก้ไขจากการเข้าตรวจคลังสินค้า DC ถูกบันทึกในระบบเรียบร้อยแล้ว&#34; +&#10;    &#34;&#60;/div&#62;&#34; +&#10;&#10;    &#34;&#60;p style=&#39;margin-top: 20px;&#39;&#62;หากมีการปรับปรุงเพิ่มเติม หรือมีประเด็นที่ต้องชี้แจงเพิ่มเติม &#34; +&#10;    &#34;ระบบจะแจ้งให้ท่านทราบต่อไป&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p style=&#39;margin-top: 20px;&#39;&#62;&#60;strong&#62;ขอบคุณค่ะ/ครับ&#60;/strong&#62;&#60;br&#62;&#34; +&#10;    &#34;ระบบแจ้งเตือนอัตโนมัติ&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p style=&#39;text-align: center; color: #888; font-size: 11px; margin-top: 30px; border-top: 1px solid #eee; padding-top: 10px;&#39;&#62;&#34; +&#10;        &#34;Enterprise Automation | DC Inspection Notification Service&#34; +&#10;    &#34;&#60;/p&#62;&#34; +&#10;&#34;&#60;/div&#62;&#34;&#10;" target="body" />
          <zeebe:input source="=[&#34;jumphonkae@gosoft.co.th&#34;]" target="sendto" />
          <zeebe:input source="=[&#34;jumphonkae@gosoft.co.th&#34;]" target="ccto" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="service" value="Cloud_SendMail" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0o4q1e5</bpmn:incoming>
      <bpmn:outgoing>Flow_08umipi</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_1ufkxc6" name="อัพเดตฐานข้อมูล" zeebe:modelerTemplate="cloud-sql-connector" zeebe:modelerTemplateVersion="3" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="customConnector" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="POSTGRESQL" target="database" />
          <zeebe:input source="detailed" target="connection.authType" />
          <zeebe:input source="=&#34;{{secret.HOST_POSTGRESQL_PMAM}}&#34;" target="connection.host" />
          <zeebe:input source="=&#34;{{secret.PORT_POSTGRESQL_PMAM}}&#34;" target="connection.port" />
          <zeebe:input source="=&#34;{{secret.USERNAME_POSTGRESQL_PMAM}}&#34;" target="connection.username" />
          <zeebe:input source="=&#34;{{secret.PASSWORD_POSTGRESQL_PMAM}}&#34;" target="connection.password" />
          <zeebe:input source="=&#34;{{secret.DB_NAME_POSTGRESQL_PMAM}}&#34;" target="connection.databaseName" />
          <zeebe:input source="=true" target="data.returnResults" />
          <zeebe:input source="=&#34;UPDATE public.dc_items SET status = &#39;pending_plan_review&#39;, updated_at = NOW() AT TIME ZONE &#39;Asia/Bangkok&#39; WHERE doc_no = :doc_no AND process_instance_key = :strProcessInstanceKey;&#34;" target="data.query" />
          <zeebe:input source="={&#10;  doc_no: doc_no,&#10;  strProcessInstanceKey: strProcessInstanceKey&#10;}" target="data.variables" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="service" value="sql" />
          <zeebe:header key="elementTemplateVersion" value="3" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.Jdbc.v1" />
          <zeebe:header key="resultVariable" value="output" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0xr73ft</bpmn:incoming>
      <bpmn:outgoing>Flow_0o4q1e5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_1fez8o9" name="แจ้งผู้มีส่วนเกี่ยวข้อง" zeebe:modelerTemplate="Cloud_center_SendMail_Connecter" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="customConnector" />
        <zeebe:ioMapping>
          <zeebe:input source="GoflowEmail" target="authentication.type" />
          <zeebe:input source="html" target="sendMail_body_content_type" />
          <zeebe:input source="=&#34;แจ้งเตือนการมอบหมายผู้ติดตามผลการตรวจคลังสินค้า DC&#34;" target="subject" />
          <zeebe:input source="=&#34;&#60;div style=&#39;font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 600px;&#39;&#62;&#34; +&#10;    &#34;&#60;p&#62;&#34; +&#10;        &#34;&#60;strong style=&#39;color: #1e88e5; font-size: 18px;&#39;&#62;แจ้งเตือนการมอบหมายผู้รับผิดชอบติดตามผล&#60;/strong&#62;&#34; +&#10;    &#34;&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p&#62;ตามที่หน่วยงานได้ดำเนินการเข้าตรวจคลังสินค้า DC ตามรอบการตรวจที่กำหนด &#34; +&#10;    &#34;และมีการกรอกแผนการแก้ไขในระบบเรียบร้อยแล้ว&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p&#62;ระบบได้ดำเนินการ &#60;strong&#62;มอบหมายผู้รับผิดชอบในการติดตามผล (Follow up)&#60;/strong&#62; &#34; +&#10;    &#34;เพื่อทำหน้าที่ติดตามความคืบหน้าการดำเนินการแก้ไข ตรวจสอบการปฏิบัติตามแผน &#34; +&#10;    &#34;และประสานงานในขั้นตอนที่เกี่ยวข้องตามกระบวนการที่กำหนด&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;ul style=&#39;padding-left: 20px; margin: 15px 0;&#39;&#62;&#34; +&#10;        &#34;&#60;li style=&#39;margin-bottom: 8px;&#39;&#62;🔹 ติดตามสถานะการดำเนินการแก้ไขตามแผน&#60;/li&#62;&#34; +&#10;        &#34;&#60;li style=&#39;margin-bottom: 8px;&#39;&#62;🔹 ตรวจสอบความครบถ้วนและความคืบหน้าของการแก้ไข&#60;/li&#62;&#34; +&#10;        &#34;&#60;li style=&#39;margin-bottom: 8px;&#39;&#62;🔹 อัปเดตสถานะและข้อมูลในระบบตามระยะที่กำหนด&#60;/li&#62;&#34; +&#10;    &#34;&#60;/ul&#62;&#34; +&#10;&#10;    &#34;&#60;div style=&#39;background: #e3f2fd; padding: 15px; border-left: 5px solid #2196f3; margin-top: 15px;&#39;&#62;&#34; +&#10;        &#34;&#60;strong&#62;สถานะปัจจุบัน:&#60;/strong&#62;&#60;br&#62;&#34; +&#10;        &#34;ได้กำหนดผู้รับผิดชอบการติดตามผลจากการเข้าตรวจคลังสินค้า DC เรียบร้อยแล้ว&#34; +&#10;    &#34;&#60;/div&#62;&#34; +&#10;&#10;    &#34;&#60;p style=&#39;margin-top: 20px;&#39;&#62;กรุณาดำเนินการติดตามผลและอัปเดตข้อมูลผ่านระบบ &#34; +&#10;    &#34;เพื่อให้การแก้ไขเป็นไปตามแผนและระยะเวลาที่กำหนด หากพบประเด็นเพิ่มเติม &#34; +&#10;    &#34;สามารถบันทึกหรือประสานงานผ่านระบบได้โดยตรง&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p style=&#39;margin-top: 20px;&#39;&#62;&#60;strong&#62;ขอบคุณค่ะ/ครับ&#60;/strong&#62;&#60;br&#62;&#34; +&#10;    &#34;ระบบแจ้งเตือนอัตโนมัติ&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p style=&#39;text-align: center; color: #888; font-size: 11px; margin-top: 30px; border-top: 1px solid #eee; padding-top: 10px;&#39;&#62;&#34; +&#10;        &#34;Enterprise Automation | DC Follow up Notification Service&#34; +&#10;    &#34;&#60;/p&#62;&#34; +&#10;&#34;&#60;/div&#62;&#34;" target="body" />
          <zeebe:input source="=[&#34;jumphonkae@gosoft.co.th&#34;]" target="sendto" />
          <zeebe:input source="=[&#34;jumphonkae@gosoft.co.th&#34;]" target="ccto" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="service" value="Cloud_SendMail" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0xxnv4h</bpmn:incoming>
      <bpmn:outgoing>Flow_1jw18l8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_1x6y2na" name="อัพเดตฐานข้อมูล" zeebe:modelerTemplate="cloud-sql-connector" zeebe:modelerTemplateVersion="3" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
