      <zeebe:userTaskForm id="UserTaskForm_34ak5kp">{
  "components": [
    {
      "text": "=if item_type = \"car\" then \"# เกิด CAR ที่จำเป็นต้องลงไปแก้ไข\" else \"# เกิด Suggestion ที่จำเป็นต้องดำเนินการ\"",
