    <bpmn:textAnnotation id="TextAnnotation_00ojzhq">
      <bpmn:text>กระบวนการนี้สามารถเปิด OFIs ได้หลายใบ</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0zgf74e">
