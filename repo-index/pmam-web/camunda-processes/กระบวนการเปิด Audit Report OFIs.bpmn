    <bpmn:serviceTask id="Activity_125zzpm" name="แจ้งเตือนผู้ เกี่ยวข้อง (Auditor)" zeebe:modelerTemplate="Cloud_center_SendMail_Connecter" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="customConnector" />
        <zeebe:ioMapping>
          <zeebe:input source="GoflowEmail" target="authentication.type" />
          <zeebe:input source="html" target="sendMail_body_content_type" />
          <zeebe:input source="=&#34;ผลการพิจารณา: ไม่อนุมัติการเปิด OFIs&#34;" target="subject" />
          <zeebe:input source="=&#34;&#60;div style=&#39;font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 650px;&#39;&#62;&#34; +&#10;&#10;    &#34;&#60;p&#62;&#60;strong style=&#39;color: #d32f2f; font-size: 20px;&#39;&#62;แจ้งผลการพิจารณา: ไม่อนุมัติการเปิด OFIs&#60;/strong&#62;&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p&#62;ตามที่ท่านได้ดำเนินการส่งข้อมูลเพื่อขอเปิด OFIs ระบบได้ส่งผลการตรวจสอบให้ผู้บริหารพิจารณาแล้ว และได้รับแจ้งว่า &#60;strong&#62;ไม่สามารถอนุมัติได้ในขณะนี้&#60;/strong&#62; เนื่องจากมีประเด็นที่ต้องตรวจสอบเพิ่มเติม&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;div style=&#39;background: #ffebee; padding: 15px; border-left: 5px solid #d32f2f; margin: 18px 0;&#39;&#62;&#34; +&#10;        &#34;&#60;strong&#62;สรุปผลการพิจารณา:&#60;/strong&#62;&#60;br&#62;&#34; +&#10;        &#34;คำขอเปิด OFIs ยังไม่ผ่านการพิจารณา กรุณาทำการตรวจสอบข้อมูลที่เกี่ยวข้องและดำเนินการตามขั้นตอนที่ถูกต้องก่อนยื่นคำขอใหม่&#34; +&#10;    &#34;&#60;/div&#62;&#34; +&#10;&#10;    &#34;&#60;p&#62;หากต้องการส่งคำขออีกครั้ง กรุณาตรวจสอบความครบถ้วนของข้อมูลก่อนดำเนินการ เพื่อให้การพิจารณาเป็นไปอย่างราบรื่น&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p style=&#39;margin-top: 20px;&#39;&#62;&#60;strong&#62;ขอบคุณค่ะ/ครับ&#60;/strong&#62;&#60;br&#62;ระบบแจ้งเตือนอัตโนมัติ&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p style=&#39;text-align: center; color: #888; font-size: 11px; margin-top: 30px; border-top: 1px solid #eee; padding-top: 10px;&#39;&#62;&#34; +&#10;        &#34;RPA Automation Service&#34; +&#10;    &#34;&#60;/p&#62;&#34; +&#10;&#10;&#34;&#60;/div&#62;&#34;" target="body" />
          <zeebe:input source="=related_party_emails" target="sendto" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="service" value="Cloud_SendMail" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1oki3po</bpmn:incoming>
      <bpmn:outgoing>Flow_1i4cfnw</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_0h5h0qb" name="แจ้งเตือนผู้ เกี่ยวข้อง (Auditor)" zeebe:modelerTemplate="Cloud_center_SendMail_Connecter" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="customConnector" />
        <zeebe:ioMapping>
          <zeebe:input source="GoflowEmail" target="authentication.type" />
          <zeebe:input source="html" target="sendMail_body_content_type" />
          <zeebe:input source="=&#34;เปิด OFIs เรียบร้อย&#34;" target="subject" />
          <zeebe:input source="=&#34;&#60;div style=&#39;font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 650px;&#39;&#62;&#34; +&#10;&#10;    &#34;&#60;p&#62;&#60;strong style=&#39;color: #1e88e5; font-size: 20px;&#39;&#62;เปิด OFIs เรียบร้อย&#60;/strong&#62;&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p&#62;ระบบได้ดำเนินการเปิด OFIs ตามข้อมูลที่ท่านส่งเข้ามาเรียบร้อยแล้ว โดยไม่มีข้อผิดพลาดและพร้อมสำหรับการดำเนินการขั้นถัดไป&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;div style=&#39;background: #e3f2fd; padding: 15px; border-left: 5px solid #2196f3; margin: 18px 0;&#39;&#62;&#34; +&#10;        &#34;&#60;strong&#62;สรุปผลการดำเนินการ:&#60;/strong&#62;&#60;br&#62;&#34; +&#10;        &#34;รายการ OFIs ได้ถูกเปิดสำเร็จ และสามารถดำเนินงานต่อได้ตามขั้นตอนที่กำหนด&#34; +&#10;    &#34;&#60;/div&#62;&#34; +&#10;&#10;    &#34;&#60;p&#62;หากต้องการตรวจสอบข้อมูลเพิ่มเติม สามารถเข้าไปดูรายละเอียดได้ในระบบตามสิทธิ์การเข้าถึงของท่าน&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p style=&#39;margin-top: 20px;&#39;&#62;&#60;strong&#62;ขอบคุณค่ะ/ครับ&#60;/strong&#62;&#60;br&#62;ระบบแจ้งเตือนอัตโนมัติ&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p style=&#39;text-align: center; color: #888; font-size: 11px; margin-top: 30px; border-top: 1px solid #eee; padding-top: 10px;&#39;&#62;&#34; +&#10;        &#34;RPA Automation Service&#34; +&#10;    &#34;&#60;/p&#62;&#34; +&#10;&#10;&#34;&#60;/div&#62;&#34;" target="body" />
          <zeebe:input source="=related_party_emails" target="sendto" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="service" value="Cloud_SendMail" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1y9eurg</bpmn:incoming>
      <bpmn:outgoing>Flow_154ella</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_1277tu6" name="จบกระบวนการ">
      <bpmn:incoming>Flow_1i4cfnw</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Event_1nqmgyr" name="จบกระบวนการ">
      <bpmn:incoming>Flow_154ella</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Activity_1eu545m" name="แจ้งเตือน Auditor แก้ไขข้อมูล" zeebe:modelerTemplate="Cloud_center_SendMail_Connecter" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="customConnector" />
        <zeebe:ioMapping>
          <zeebe:input source="GoflowEmail" target="authentication.type" />
          <zeebe:input source="html" target="sendMail_body_content_type" />
          <zeebe:input source="=&#34;ผลการพิจารณาข้อมูล: ส่งกลับเพื่อปรับปรุงแก้ไข&#34;" target="subject" />
          <zeebe:input source="=&#34;&#60;div style=&#39;font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 650px;&#39;&#62;&#34; +&#10;&#10;    &#34;&#60;p&#62;&#60;strong style=&#39;color: #d32f2f; font-size: 20px;&#39;&#62;แจ้งผลการพิจารณา: ส่งกลับเพื่อแก้ไข&#60;/strong&#62;&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p&#62;ข้อมูลที่ส่งเข้าตรวจสอบยังไม่ผ่านการอนุมัติ และจำเป็นต้องปรับปรุงตามรายละเอียดดังต่อไปนี้:&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;div style=&#39;background: #ffebee; padding: 15px; border-left: 5px solid #d32f2f; margin: 18px 0;&#39;&#62;&#34; +&#10;        &#34;&#60;strong&#62;รายละเอียดที่ต้องแก้ไข:&#60;/strong&#62;&#60;br&#62;&#34; +&#10;        edit_detail +&#10;    &#34;&#60;/div&#62;&#34; +&#10;&#10;    &#34;&#60;p&#62;กรุณาตรวจสอบและแก้ไขข้อมูลให้ถูกต้องครบถ้วน ก่อนทำการส่งกลับเข้าสู่ระบบเพื่อพิจารณาใหม่อีกครั้ง&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p style=&#39;margin-top: 20px;&#39;&#62;&#60;strong&#62;ขอบคุณค่ะ/ครับ&#60;/strong&#62;&#60;br&#62;ระบบแจ้งเตือนอัตโนมัติ&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p style=&#39;text-align: center; color: #888; font-size: 11px; margin-top: 30px; border-top: 1px solid #eee; padding-top: 10px;&#39;&#62;&#34; +&#10;        &#34;RPA Automation Service&#34; +&#10;    &#34;&#60;/p&#62;&#34; +&#10;&#10;&#34;&#60;/div&#62;&#34;" target="body" />
          <zeebe:input source="=related_party_emails" target="sendto" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="service" value="Cloud_SendMail" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_07tc3sw</bpmn:incoming>
      <bpmn:outgoing>Flow_0z6ht2x</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_027ru53" name="อัพเดตฐานข้อมูล" zeebe:modelerTemplate="cloud-sql-connector" zeebe:modelerTemplateVersion="3" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="customConnector" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="POSTGRESQL" target="database" />
          <zeebe:input source="detailed" target="connection.authType" />
          <zeebe:input source="=&#34;{{secret.HOST_POSTGRESQL_PMAM}}&#34;" target="connection.host" />
          <zeebe:input source="=&#34;{{secret.PORT_POSTGRESQL_PMAM}}&#34;" target="connection.port" />
          <zeebe:input source="=&#34;{{secret.USERNAME_POSTGRESQL_PMAM}}&#34;" target="connection.username" />
          <zeebe:input source="=&#34;{{secret.PASSWORD_POSTGRESQL_PMAM}}&#34;" target="connection.password" />
          <zeebe:input source="=&#34;{{secret.DB_NAME_POSTGRESQL_PMAM}}&#34;" target="connection.databaseName" />
          <zeebe:input source="=true" target="data.returnResults" />
          <zeebe:input source="=&#34;UPDATE public.isa_audits SET status = &#39;no_approve&#39; WHERE doc_no = :doc_no&#34;" target="data.query" />
          <zeebe:input source="={doc_no: doc_no}" target="data.variables" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="service" value="sql" />
          <zeebe:header key="elementTemplateVersion" value="3" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.Jdbc.v1" />
          <zeebe:header key="resultVariable" value="output" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0fvkegx</bpmn:incoming>
      <bpmn:outgoing>Flow_1oki3po</bpmn:outgoing>
    </bpmn:serviceTask>
