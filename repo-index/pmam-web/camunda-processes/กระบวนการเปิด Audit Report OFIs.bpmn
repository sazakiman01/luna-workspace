    <bpmn:serviceTask id="Activity_1xvoh1h" name="เปิด OFIs" zeebe:modelerTemplate="cloud.restcall.connectors.HttpJson" zeebe:modelerTemplateVersion="5" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
