    <bpmn:serviceTask id="Activity_1119cw9" name="แจ้งเตือนผู้ เกี่ยวข้อง" zeebe:modelerTemplate="Cloud_center_SendMail_Connecter" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="customConnector" />
        <zeebe:ioMapping>
          <zeebe:input source="GoflowEmail" target="authentication.type" />
          <zeebe:input source="html" target="sendMail_body_content_type" />
          <zeebe:input source="=&#34;รายงานผลการตรวจสอบข้อมูลประจำรอบ (ไม่พบ OFIs)&#34;" target="subject" />
          <zeebe:input source="=&#34;&#60;div style=&#39;font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 600px;&#39;&#62;&#34; +&#10;    &#34;&#60;p&#62;&#34; +&#10;        &#34;&#60;strong style=&#39;color: #1e88e5; font-size: 18px;&#39;&#62;แจ้งเตือนผลการตรวจสอบประจำรอบ&#60;/strong&#62;&#34; +&#10;    &#34;&#60;/p&#62;&#34; +&#10;    &#10;    &#34;&#60;p&#62;ระบบได้ทำการประมวลผลข้อมูล PMAM ประจำรอบที่กำหนดเรียบร้อยแล้ว โดยมีรายละเอียดดังนี้:&#60;/p&#62;&#34; +&#10;    &#10;    &#34;&#60;ul style=&#39;padding-left: 20px; margin: 15px 0;&#39;&#62;&#34; +&#10;        &#34;&#60;li style=&#39;margin-bottom: 8px;&#39;&#62;🔹 ไม่พบรายการ OFIs ในรอบนี้&#60;/li&#62;&#34; +&#10;        &#34;&#60;li style=&#39;margin-bottom: 8px;&#39;&#62;🔹 ข้อมูลที่ประมวลผลถูกต้องสมบูรณ์&#60;/li&#62;&#34; +&#10;        &#34;&#60;li style=&#39;margin-bottom: 8px;&#39;&#62;🔹 ไม่พบความผิดปกติของข้อมูลเพิ่มเติม&#60;/li&#62;&#34; +&#10;    &#34;&#60;/ul&#62;&#34; +&#10;&#10;    &#34;&#60;div style=&#39;background: #e3f2fd; padding: 15px; border-left: 5px solid #2196f3; margin-top: 15px;&#39;&#62;&#34; +&#10;        &#34;&#60;strong&#62;สรุปผล:&#60;/strong&#62;&#60;br&#62;&#34; +&#10;        &#34;ระบบทำงานสำเร็จและไม่พบรายการที่ต้องดำเนินการเพิ่มเติมค่ะ/ครับ&#34; +&#10;    &#34;&#60;/div&#62;&#34; +&#10;&#10;    &#34;&#60;p style=&#39;margin-top: 20px;&#39;&#62;หากต้องการตรวจสอบข้อมูลย้อนหลัง สามารถเข้าใช้งานระบบ PMAM ได้ตามสิทธิ์ของท่าน&#60;/p&#62;&#34; +&#10;    &#10;    &#34;&#60;p style=&#39;margin-top: 20px;&#39;&#62;&#60;strong&#62;ขอบคุณค่ะ/ครับ&#60;/strong&#62;&#60;br&#62;ระบบแจ้งเตือนอัตโนมัติ PMAM&#60;/p&#62;&#34; +&#10;    &#10;    &#34;&#60;p style=&#39;text-align: center; color: #888; font-size: 11px; margin-top: 30px; border-top: 1px solid #eee; padding-top: 10px;&#39;&#62;&#34; +&#10;        &#34;RPA Automation Service&#34; +&#10;    &#34;&#60;/p&#62;&#34; +&#10;&#34;&#60;/div&#62;&#34;" target="body" />
          <zeebe:input source="=related_party_emails" target="sendto" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="service" value="Cloud_SendMail" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1hryfbb</bpmn:incoming>
      <bpmn:outgoing>Flow_0g2lqlv</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_0pyyi0f" name="Set Env" zeebe:modelerTemplate="cloud_set_global_env_connector" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/png;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="customConnector" />
        <zeebe:ioMapping>
          <zeebe:input source="={}" target="payload" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="service" value="setenv" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0v6malb</bpmn:incoming>
      <bpmn:outgoing>Flow_109mj1q</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_1ql9iot" name="แจ้งเตือน(Head Of Auditor)" zeebe:modelerTemplate="Cloud_center_SendMail_Connecter" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="customConnector" />
        <zeebe:ioMapping>
          <zeebe:input source="GoflowEmail" target="authentication.type" />
          <zeebe:input source="html" target="sendMail_body_content_type" />
          <zeebe:input source="=&#34;ผลการประมวลผลข้อมูลประจำรอบ: พบรายการ OFIs ที่ต้องดำเนินการ&#34;" target="subject" />
          <zeebe:input source="=&#34;&#60;div style=&#39;font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 650px;&#39;&#62;&#34; +&#10;&#10;    &#34;&#60;p&#62;&#60;strong style=&#39;color: #d32f2f; font-size: 20px;&#39;&#62;แจ้งเตือนผลการประมวลผลข้อมูล&#60;/strong&#62;&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p&#62;ระบบได้ทำการตรวจสอบข้อมูลแล้ว และพบว่ามีรายการ OFIs ที่ต้องดำเนินการ จำนวน &#60;strong&#62;&#34; + string(ofi_count) + &#34;&#60;/strong&#62; รายการ&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;div style=&#39;background: #fff3e0; padding: 15px; border-left: 5px solid #f57c00; margin: 18px 0;&#39;&#62;&#34; +&#10;        &#34;&#60;strong&#62;สรุปผล:&#60;/strong&#62;&#60;br&#62;&#34; +&#10;        &#34;มีรายการ OFIs ที่ต้องติดตาม กรุณาเข้าสู่ระบบเพื่อตรวจสอบรายละเอียดเพิ่มเติม&#34; +&#10;    &#34;&#60;/div&#62;&#34; +&#10;&#10;    &#34;&#60;p style=&#39;margin-top: 20px;&#39;&#62;&#60;strong&#62;ขอบคุณค่ะ/ครับ&#60;/strong&#62;&#60;br&#62;ระบบแจ้งเตือนอัตโนมัติ&#60;/p&#62;&#34; +&#10;&#10;    &#34;&#60;p style=&#39;text-align: center; color: #888; font-size: 11px; margin-top: 30px; border-top: 1px solid #eee; padding-top: 10px;&#39;&#62;RPA Automation Service&#60;/p&#62;&#34; +&#10;&#34;&#60;/div&#62;&#34;" target="body" />
          <zeebe:input source="=related_party_emails" target="sendto" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="service" value="Cloud_SendMail" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0lfl1uw</bpmn:incoming>
      <bpmn:outgoing>Flow_0lw4t1l</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_18cxgwn" name="อัพเดตฐานข้อมูล" zeebe:modelerTemplate="cloud-sql-connector" zeebe:modelerTemplateVersion="3" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="customConnector" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="POSTGRESQL" target="database" />
          <zeebe:input source="detailed" target="connection.authType" />
          <zeebe:input source="=&#34;{{secret.HOST_POSTGRESQL_PMAM}}&#34;" target="connection.host" />
          <zeebe:input source="=&#34;{{secret.PORT_POSTGRESQL_PMAM}}&#34;" target="connection.port" />
          <zeebe:input source="=&#34;{{secret.USERNAME_POSTGRESQL_PMAM}}&#34;" target="connection.username" />
          <zeebe:input source="=&#34;{{secret.PASSWORD_POSTGRESQL_PMAM}}&#34;" target="connection.password" />
          <zeebe:input source="=&#34;{{secret.DB_NAME_POSTGRESQL_PMAM}}&#34;" target="connection.databaseName" />
          <zeebe:input source="=true" target="data.returnResults" />
          <zeebe:input source="=&#34;UPDATE public.isa_audits SET audit_date = :audit_date, team_lead = :team_lead, team_lead_title = :team_lead_title, strength_count = :strength_count, ofi_count = :ofi_count, suggestion_count = :suggestion_count, status = :status, updated_at = NOW() WHERE doc_no = :doc_no&#34;" target="data.query" />
          <zeebe:input source="={doc_no: doc_no, audit_date: audit_date, team_lead: team_lead, team_lead_title: team_lead_title, strength_count: strength_count, ofi_count: ofi_count, suggestion_count: suggestion_count, status: status}&#10;" target="data.variables" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="service" value="sql" />
          <zeebe:header key="elementTemplateVersion" value="3" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.Jdbc.v1" />
          <zeebe:header key="resultVariable" value="output" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0hsi1g1</bpmn:incoming>
      <bpmn:outgoing>Flow_1dt8lf6</bpmn:outgoing>
    </bpmn:serviceTask>
