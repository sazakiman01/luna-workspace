{
  "permissions": {
    "allow": [
      "Bash(powershell.exe -NoProfile -File \"C:\\Users\\sansakritsuk\\.claude\\luna-workspace\\scripts\\auto-archive.ps1\"*)",
      "Bash(powershell.exe -NoProfile -File \"C:\\Users\\sansakritsuk\\.claude\\luna-workspace\\scripts\\session-reminders.ps1\"*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.credentials.json)",
      "Read(**/credentials.json)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa)",
      "Read(**/id_rsa.*)",
      "Read(**/.aws/**)",
      "Read(**/secrets/**)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "skillOverrides": {
    "anthropic-skills:algorithmic-art": "off",
    "anthropic-skills:brand-guidelines": "off",
    "anthropic-skills:canvas-design": "off",
    "anthropic-skills:slack-gif-creator": "off",
    "anthropic-skills:theme-factory": "off",
    "anthropic-skills:internal-comms": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:mcp-builder": "off",
    "anthropic-skills:web-artifacts-builder": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:learn": "off",
    "anthropic-skills:doc-coauthoring": "off",
    "anthropic-skills:docs": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -File \"C:\\Users\\sansakritsuk\\.claude\\luna-workspace\\scripts\\auto-archive.ps1\" -CheckOnly",
            "timeout": 30,
            "statusMessage": "Luna: ตรวจ context bloat"
          },
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -File \"C:\\Users\\sansakritsuk\\.claude\\luna-workspace\\scripts\\session-reminders.ps1\"",
            "timeout": 30,
            "statusMessage": "Luna: ตรวจ daily log + retro"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -File \"C:\\Users\\sansakritsuk\\.claude\\luna-workspace\\scripts\\worklog-append.ps1\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -File \"C:\\Users\\sansakritsuk\\.claude\\luna-workspace\\scripts\\log-gate.ps1\"",
            "timeout": 10,
            "statusMessage": "Luna: ตรวจ decision log"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "powershell.exe -NoProfile -File C:/Users/sansakritsuk/.claude/luna-statusline.ps1",
    "padding": 0
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/claude-plugins-official.git"
      }
    }
  },
  "outputStyle": "Concise",
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "ลูน่ากำลังคิด",
      "ลูน่ากำลังจัดการ",
      "ลูน่ากำลังโฟกัส",
      "ลูน่ากำลังลุย",
      "ลูน่ากำลังค้นข้อมูล",
      "ลูน่ากำลังเรียบเรียง",
      "ลูน่ากำลังพิจารณา",
      "ลูน่ากำลังตั้งใจทำ"
    ]
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "skipWorkflowUsageWarning": true,
  "theme": "light",
  "remoteControlAtStartup": false,
  "isolatePeerMachines": true,
  "crossSessionInbound": "refuse",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
