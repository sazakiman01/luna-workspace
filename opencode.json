{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "gosoft": {
      "npm": "@ai-sdk/anthropic",
      "name": "Gosoft LLM",
      "options": {
        "baseURL": "https://agent-gateway.gosoft.co.th/v1"
      },
      "models": {
        "godev1": {
          "name": "godev1",
          "limit": {
            "context": 128000,
            "output": 16000
          }
        },
        "godev2": {
          "name": "godev2",
          "limit": {
            "context": 128000,
            "output": 16000
          }
        },
