            "context": 128000,
            "output": 16000
          }
        },
        "gothink3": {
          "name": "gothink3",
          "limit": {
            "context": 128000,
            "output": 16000
          }
        }
      }
    }
  },
  "model": "gosoft/godev1",
  "mcp": {
    "servers": {
      "ds": {
        "type": "remote",
        "url": "https://agent-gateway.gosoft.co.th/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:LITELLM_KEY}",
          "x-mcp-servers": "ds"
        }
      },
      "dv": {
        "type": "remote",
        "url": "https://agent-gateway.gosoft.co.th/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:LITELLM_KEY}",
          "x-mcp-servers": "dv"
        }
      },
      "km": {
        "type": "remote",
        "url": "https://agent-gateway.gosoft.co.th/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:LITELLM_KEY}",
          "x-mcp-servers": "km"
        }
      }
    }
  },
